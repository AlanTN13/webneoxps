{
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://nexopsticketera.vercel.app/_next/:path*"
    },
    {
      "source": "/portal",
      "destination": "https://nexopsticketera.vercel.app/portal"
    },
    {
      "source": "/portal/:path*",
      "destination": "https://nexopsticketera.vercel.app/portal/:path*"
    },
    {
      "source": "/backoffice",
      "destination": "https://nexopsticketera.vercel.app/backoffice"
    },
    {
      "source": "/backoffice/:path*",
      "destination": "https://nexopsticketera.vercel.app/backoffice/:path*"
    },
    {
      "source": "/noticias",
      "destination": "/index.html"
    },
    {
      "source": "/noticias/:slug",
      "destination": "/index.html"
    }
  ]
}
